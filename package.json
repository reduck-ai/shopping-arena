{
	"name": "shopping-arena",
	"private": true,
	"type": "module",
	"description": "Benchmark AI shopping agents (ShopDuck, Muse) on real stores, each task a prompt plus an optional check, read their Claude Code sessions over MCP, and replay them side by side",
	"license": "MIT",
	"repository": "github:reduck-ai/shopping-arena",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"bench": "node run.ts",
		"mcp": "node --watch mcp.ts",
		"replay": "vite",
		"export": "node export.ts",
		"build": "vite build",
		"check": "svelte-check"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.280",
		"@fortawesome/fontawesome-svg-core": "7.3.1",
		"@fortawesome/free-solid-svg-icons": "7.3.1",
		"@fortawesome/svelte-fontawesome": "0.2.4",
		"@modelcontextprotocol/sdk": "1.29.0",
		"marked": "18.0.14",
		"posthog-js": "1.434.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@types/node": "22.19.17",
		"svelte": "5.55.7",
		"svelte-check": "4.4.8",
		"typescript": "6.0.3",
		"vite": "8.3.0"
	}
}
